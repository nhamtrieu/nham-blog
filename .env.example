APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Nham Blog
NEXTAUTH_SECRET=replace-with-at-least-32-characters
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/nham-blog
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Nham Admin

# Optional internal URL for server-to-server auth callbacks.
# NEXTAUTH_URL_INTERNAL=http://127.0.0.1:3000

# Google OAuth (reader login). Optional until both are set.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional Redis for multi-instance realtime notification fan-out (SSE)
# and auth rate limits (login / register / resend verification).
# Without REDIS_URL, in-process EventEmitter + in-memory rate limits are used.
# REDIS_URL=redis://127.0.0.1:6379

# Email verification (Resend required to actually send).
# Without RABBITMQ_URL, the API sends email inline (fine for local).
# With RABBITMQ_URL: docker compose up -d rabbitmq && yarn worker:email
# RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Nham Blog <onboarding@resend.dev>

# Cloudinary is required for image uploads.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Firebase Analytics is required only in production.
# NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
# NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXX
